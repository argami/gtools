{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/pre-commit-review/src/before-commit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(rtk git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/pre-commit-review/src/before-commit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/post-push-review/src/after-push.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "if": "Bash(rtk git *)",
            "command": "${CLAUDE_PLUGIN_ROOT}/skills/post-push-review/src/after-push.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
